    "atsakymai": [
      {
        "tekstas": "Jį išgąsdino griaustinis.",
        "teisingas": false
      },
      {
        "tekstas": "Kalne labai šalta.",
        "teisingas": false
      },
      {
        "tekstas": "Akmenys užtvėrė praėjimą.",
        "teisingas": true
      },
      {
        "tekstas": "Jis nori pasivaikščioti po kalnus.",
        "teisingas": false
      }
