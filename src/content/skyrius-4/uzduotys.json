      },
      {
        "tekstas": "Atiteko Pteriukui.",
        "teisingas": false
      },
      {
        "tekstas": "Nugrimzdo vandenyje.",
        "teisingas": true
      },
      {
        "tekstas": "Liko plyšyje tarp uolų.",
